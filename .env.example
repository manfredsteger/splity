# Host-Pfad für das Docker-Volume (z. B. auf macOS oder Linux)
SPLITY_PATH=/Users/DEINNAME/Movies/Splity
# Bibliothek (nur lesend). ACHTUNG: NICHT /Users/DEINNAME/Movies als Ganzes eintragen –
# Docker Desktop haengt beim Einbinden dieses Ordners (Apple-TV-Mediathek darin).
# Unterordner funktionieren, z. B. der Splity-Ordner selbst oder ~/Movies/Bibliothek.
SPLITY_LIBRARY_PATH=/Users/DEINNAME/Movies/Splity
